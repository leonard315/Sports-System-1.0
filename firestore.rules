rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    function isJudge() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_judge/$(request.auth.uid));
    }
    function isAdminOrJudge() {
      return isAdmin() || isJudge();
    }

    match /teams/{teamId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /matches/{matchId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /roles_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /roles_judge/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /judged_events/{eventId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /event_participants/{participantId} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdminOrJudge();
    }
    match /judges_registry/{judgeId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
    match /account_requests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
    match /app_users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }
  }
}
