/**
 * Firestore Security Rules
 *
 * CORE PHILOSOPHY:
 * Tournament data (Teams, Matches, Events) is publicly readable for transparency.
 * All write operations are restricted to verified administrators or judges.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isJudge() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_judge/$(request.auth.uid));
    }

    function isAdminOrJudge() {
      return isAdmin() || isJudge();
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Teams ---
    match /teams/{teamId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == teamId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    // --- Matches ---
    match /matches/{matchId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == matchId;
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      allow delete: if isExistingAdmin();
    }

    // --- Admin Roles ---
    match /roles_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // --- Judge Roles ---
    match /roles_judge/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; // Only created via Admin SDK (server-side)
    }

    // --- Judged Events ---
    match /judged_events/{eventId} {
      allow get, list: if true; // Public read
      allow create: if isAdmin() && request.resource.data.id == eventId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Event Participants ---
    match /event_participants/{participantId} {
      allow get, list: if true; // Public read for live results
      allow create: if isAdmin() && request.resource.data.id == participantId;
      allow update: if isAdminOrJudge(); // Judges can update scores
      allow delete: if isAdmin();
    }

    // --- Judges Registry ---
    match /judges_registry/{judgeId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.id == judgeId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Account Requests ---
    match /account_requests/{requestId} {
      allow create: if true; // Anyone can submit a request
      allow get, list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- App Users ---
    match /app_users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
